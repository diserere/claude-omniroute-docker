{
  "$schema": "https://openrouter.ai/docs/cookbook/coding-agents/claude-code-integration",
  "_comment": "Claude Code settings for OmniRoute. Copy to .claude/settings.json (project root). Provider keys are managed in the OmniRoute dashboard (http://localhost:20128) — not here.",
  "_warning": "Template only — copy to .claude/settings.json to activate. Do NOT commit real secrets to version control.",
  "env": {
    "ANTHROPIC_BASE_URL": "http://localhost:20128/v1",

    "_auth_note": "You MUST use an OmniRoute API key (generate in dashboard → Settings → API Keys). The placeholder 'dummy' won't work.",
    "ANTHROPIC_AUTH_TOKEN": "sk-your-omniroute-api-key-here",

    "_model_note": "IMPORTANT: Do NOT use 'auto' — Claude Code doesn't support OmniRoute's auto-routing. Use a specific model from your dashboard (e.g., 'kr/minimax-m2.5', 'kiro/glm-5'). Find available models in OmniRoute dashboard → Models.",
    "ANTHROPIC_MODEL": "kr/minimax-m2.5"
  },
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(sudo *)",
      "Bash(curl * | bash)"
    ]
  }
}
