# ──────────────────────────────────────────────────────────────────────
#  OmniRoute — Environment Variables
# ──────────────────────────────────────────────────────────────────────
#  Copy this file to .env and fill in the values.
#  NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════
# REQUIRED SECRETS — generate before first run
# ══════════════════════════════════════════════════════════════════════

# JWT signing key for dashboard session tokens.
# Generate:  openssl rand -base64 48
JWT_SECRET=

# Encryption key for API keys stored in the database (at rest).
# Generate:  openssl rand -hex 32
API_KEY_SECRET=

# Initial admin password for the dashboard on first boot.
# CHANGE THIS before first use. You can change it again from the
# dashboard after login: Settings → Security.
INITIAL_PASSWORD=CHANGEME

# ══════════════════════════════════════════════════════════════════════
# NETWORK
# ══════════════════════════════════════════════════════════════════════

# Port OmniRoute listens on (both dashboard and API).
OMNIROUTE_PORT=20128

# Redis connection URL (matches the compose service name).
REDIS_URL=redis://redis:6379

# ══════════════════════════════════════════════════════════════════════
# OPTIONAL — uncomment and adjust if needed
# ══════════════════════════════════════════════════════════════════════

# Redis port on the host (default: 6379).
# REDIS_PORT=6379

# OmniRoute data directory inside the container.
# Must match the volume mount in docker-compose.yml.
# DATA_DIR=/app/data

# Log level: debug | info | warn | error
# LOG_LEVEL=info

# Node.js memory limit (MB). Increase if you have many providers.
# OMNIROUTE_MEMORY_MB=1024
